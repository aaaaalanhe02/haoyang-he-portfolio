---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../lib/site';
import { skills } from '../lib/cv';

const certificates = [
  {
    name: 'MySQL for Data Analytics',
    issuer: 'Analyst Builder',
    date: 'Jul 2026',
    file: '/docs/mysql-certificate.png',
  },
  {
    name: 'Supervised Machine Learning: Regression and Classification',
    issuer: 'DeepLearning.AI & Stanford University (Andrew Ng)',
    date: 'Sep 2025',
    file: '/docs/coursera-1.pdf',
    verify: 'https://coursera.org/verify/7QSU5D87HR7G',
  },
  {
    name: 'Business Analytics Specialization — 5 courses',
    issuer: 'The Wharton School, University of Pennsylvania',
    date: 'Sep 2025',
    file: '/docs/coursera-2.pdf',
  },
  {
    name: 'Tableau for Data Visualization',
    issuer: 'Coursera Project Network',
    date: 'Sep 2025',
    file: '/docs/tableau-certificate.pdf',
  },
];
---

<BaseLayout
  title="About"
  description="About Haoyang (Alan) He — materials scientist, mountaineer and drummer — with CV, skills and certificates."
>
  <section class="container section about">
    <a class="back-home" href={withBase('/#home')}>← Home</a>
    <p class="eyebrow">About</p>
    <h1 class="page-title">Hello, I'm Alan.</h1>
    <div class="prose about-bio">
      <p>
        I'm a materials scientist finishing an <strong>MSc in Advanced Materials Science
        at UCL</strong>, after a BSc in Physics at the University of Edinburgh. My work
        keeps circling one question — <em>how does a material actually behave, and why?</em>
        — whether the material is a perovskite solar absorber, a bacterial biofilm, or
        blood in a spinning cylinder.
      </p>
      <p>
        I like problems that need both a rheometer and a Python script, and I care about
        materials that make cleaner technology possible. Away from the lab I climb
        mountains — <strong>Kilimanjaro</strong> and the <strong>Tour du Mont Blanc</strong>
        among them — and play drums in a thrash-metal band. Same discipline, louder.
      </p>
    </div>

    <!-- CV -->
    <div class="cv-block">
      <div class="cv-head">
        <h2 class="section-title"><span class="ico">📄</span> Curriculum Vitae</h2>
        <a class="btn btn--primary" href={withBase('/docs/CV.pdf')} target="_blank" rel="noopener">
          Download PDF ↗
        </a>
      </div>
      <object class="cv-frame" data={withBase('/docs/CV.pdf')} type="application/pdf">
        <p class="muted">
          Your browser can't display the embedded PDF.
          <a href={withBase('/docs/CV.pdf')}>Download the CV instead ↗</a>.
        </p>
      </object>
    </div>

    <!-- Skills -->
    <div class="skills-block">
      <h2 class="section-title"><span class="ico">🛠️</span> Skills</h2>
      <div class="skills-grid">
        {
          skills.map((group) => (
            <div class="skill-group">
              <h3 class="skill-label">{group.label}</h3>
              <ul class="tags">
                {group.items.map((i) => (
                  <li class="tag">{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Certificates -->
    <div class="certs-block">
      <h2 class="section-title"><span class="ico">🏅</span> Certificates</h2>
      <ul class="cert-list">
        {
          certificates.map((c) => (
            <li class="cert">
              <div class="cert-main">
                <p class="cert-name">{c.name}</p>
                <p class="muted cert-issuer">{c.issuer}</p>
              </div>
              <div class="cert-side">
                <span class="muted cert-date">{c.date}</span>
                <span class="cert-actions">
                  <a href={withBase(c.file)} target="_blank" rel="noopener">View</a>
                  {c.verify && (
                    <a href={c.verify} target="_blank" rel="noopener">Verify</a>
                  )}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact -->
    <div class="contact-block">
      <h2 class="section-title"><span class="ico">✉️</span> Get in touch</h2>
      <p class="muted">Based in {SITE.location}. Happy to talk research, materials or mountains.</p>
      <div class="contact-actions">
        <a class="btn btn--primary" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a class="btn" href={`mailto:${SITE.altEmail}`}>{SITE.altEmail}</a>
      </div>
    </div>
  </section>

  <style>
    .about { max-width: 820px; }
    .page-title { font-size: var(--step-6); margin-block: 0.2rem 0.8rem; }
    .about-bio { max-width: 68ch; }

    .cv-block, .skills-block, .certs-block, .contact-block { margin-top: 3rem; }
    .cv-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
    .cv-head .section-title { margin-bottom: 0; }
    .cv-frame {
      display: block; width: 100%; height: min(80vh, 900px);
      margin-top: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-alt);
    }

    .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.3rem; }
    .skill-label { font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-strong); margin-bottom: 0.5rem; }

    .cert-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
    .cert {
      display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; align-items: center;
      padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    }
    .cert-name { font-weight: 600; color: var(--text-strong); }
    .cert-issuer { font-size: 0.88rem; }
    .cert-side { display: flex; align-items: center; gap: 1rem; }
    .cert-date { font-size: 0.85rem; white-space: nowrap; }
    .cert-actions { display: flex; gap: 0.75rem; font-weight: 600; }

    .contact-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  </style>
</BaseLayout>
