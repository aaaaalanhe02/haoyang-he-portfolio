---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { SITE, GROUP, withBase } from '../lib/site';
import { education, skills } from '../lib/cv';
import { getGallery, getCover } from '../lib/galleries';
import type { ImageMetadata } from 'astro';
import uclLogo from '../assets/logos/ucl.png';
import ediLogo from '../assets/logos/edinburgh.png';
import njuLogo from '../assets/logos/nanjing.png';

// 机构 → 校徽（Education / Experience 时间线用；无匹配则回退首字母徽标）
const orgLogos: Record<string, ImageMetadata> = {
  'University College London': uclLogo,
  'University of Edinburgh': ediLogo,
  'Nanjing University': njuLogo,
};

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const heroBg = `url('${withBase('/hero-bg.jpg')}')`;

const heroTags = ['Perovskites', 'Rheology', 'Thin films', 'Characterisation', 'Python', 'Sustainability'];

const researchInterests = [
  { icon: '🔋', title: 'Perovskite Optoelectronics', text: 'Ion migration, charge extraction and hysteresis in next-generation solar cells and LEDs.' },
  { icon: '🧫', title: 'Soft-Matter Rheology', text: 'Viscoelasticity and yield behaviour of biofilms and other complex, living materials.' },
  { icon: '🔬', title: 'Thin Films & Characterisation', text: 'PVD, photolithography and the microscopy/spectroscopy that reads structure and defects.' },
  { icon: '🌱', title: 'Sustainable Materials', text: 'Low-cost functional materials for cleaner energy production, conversion and storage.' },
];

const certificates = [
  { year: '2026', name: 'MySQL for Data Analytics', org: 'Analyst Builder', badge: 'SQL', file: '/docs/mysql-certificate.png' },
  { year: '2025', name: 'Supervised Machine Learning: Regression & Classification', org: 'DeepLearning.AI & Stanford (Andrew Ng)', badge: 'ML', file: '/docs/coursera-1.pdf', verify: 'https://coursera.org/verify/7QSU5D87HR7G' },
  { year: '2025', name: 'Business Analytics Specialization — 5 courses', org: 'The Wharton School, UPenn', badge: 'Data', file: '/docs/coursera-2.pdf' },
  { year: '2025', name: 'Tableau for Data Visualization', org: 'Coursera Project Network', badge: 'Viz', file: '/docs/tableau-certificate.pdf' },
];

const photoPreview = getGallery('photography').slice(0, 12);
const photoTotal = getGallery('photography').length;

const adventures = [
  { slug: 'kilimanjaro', title: 'Mount Kilimanjaro', note: '5,895 m summit' },
  { slug: 'tmb', title: 'Tour du Mont Blanc', note: '~170 km circuit' },
  { slug: 'climbing', title: 'Climbing', note: 'Rock & alpine' },
].map((a) => ({ ...a, cover: getCover(a.slug) }));

const initials = (s: string) => s.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<BaseLayout>
  <!-- ============================ HERO ============================ -->
  <section id="home" class="hero" style={`--hero-bg:${heroBg}`}>
    <div class="hero-container container">
      <div class="hero-image">
        <img class="profile-photo" src={withBase('/avatar.jpg')} alt={SITE.name} width="280" height="280" />
      </div>
      <div class="hero-content">
        <h1 class="hero-title">{SITE.name} <span class="hero-nick">({SITE.nickname})</span></h1>
        <p class="hero-subtitle">{SITE.role}</p>
        <p class="hero-affiliation">
          {SITE.affiliation} ·
          <a href={GROUP.href} target="_blank" rel="noopener">{GROUP.short}</a>
        </p>
        <p class="hero-bio">
          I study how materials behave — from perovskite optoelectronics to the rheology of
          biofilms and blood — pairing careful experiments with Python analysis. Off the clock
          I climb mountains and play drums in a thrash-metal band.
        </p>
        <div class="hero-tags tags">
          {heroTags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="hero-social-icons">
          <a class="icon-link" href={`mailto:${SITE.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </a>
          <a class="icon-link" href={withBase('/docs/CV.pdf')} target="_blank" rel="noopener" aria-label="CV" title="Download CV">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3v4a1 1 0 0 0 1 1h4"></path><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"></path><path d="M12 11v6m-2.5-2.5L12 17l2.5-2.5"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= RESEARCH INTERESTS ======================= -->
  <section id="interests" class="section bg-light">
    <div class="container">
      <h2 class="section-title fade-in">Research Interests</h2>
      <div class="interests-grid">
        {researchInterests.map((it) => (
          <article class="interest-card fade-in">
            <div class="interest-icon" aria-hidden="true">{it.icon}</div>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= SELECTED WORK ========================= -->
  <section id="projects" class="section">
    <div class="container">
      <h2 class="section-title fade-in">Experience</h2>
      <p class="section-subtitle fade-in">Research, engineering and data projects — click any card for the full write-up.</p>
      <div class="card-grid fade-in">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- ============================ SKILLS ============================ -->
  <section id="skills" class="section bg-light">
    <div class="container">
      <h2 class="section-title fade-in">Technical Skills</h2>
      <div class="skills-grid">
        {skills.map((group) => (
          <article class="skill-card fade-in">
            <h4>{group.label}</h4>
            <p>{group.items.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== EDUCATION =========================== -->
  <section id="education" class="section">
    <div class="container">
      <h2 class="section-title fade-in">Education</h2>
      <div class="timeline">
        {education.map((e) => (
          <div class="timeline-item fade-in">
            <div class="timeline-date">{e.period}</div>
            <div class="timeline-badge">{orgLogos[e.org] ? <Image class="badge-logo" src={orgLogos[e.org]} alt={e.org} width={112} height={112} /> : <span class="logo-placeholder">{initials(e.org)}</span>}</div>
            <div class="timeline-content">
              <h3>{e.degree}</h3>
              <p class="institution">{e.org}</p>
              <p class="description">{e.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= CERTIFICATES ========================= -->
  <section id="certificates" class="section">
    <div class="container">
      <h2 class="section-title fade-in">Certificates</h2>
      <div class="awards-list">
        {certificates.map((c) => (
          <article class="award-item fade-in">
            <div class="award-badge-wrap"><span class="award-badge">{c.badge}</span></div>
            <div class="award-content">
              <h3>{c.name}</h3>
              <p class="award-org">{c.org} · {c.year}</p>
              <p class="award-links">
                <a href={withBase(c.file)} target="_blank" rel="noopener">View ↗</a>
                {c.verify && <a href={c.verify} target="_blank" rel="noopener">Verify ↗</a>}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================= PHOTOGRAPHY ========================= -->
  <section id="photography" class="section bg-light">
    <div class="container">
      <h2 class="section-title fade-in">Photography</h2>
      <p class="section-subtitle fade-in">A running gallery from the road and the mountains.</p>
      <div class="photo-grid fade-in">
        {photoPreview.map((img, i) => (
          <a class="photo-item" href={withBase('/photography')}>
            <Image src={img} alt={`Photograph ${i + 1}`} widths={[300, 600]} sizes="(max-width:700px) 50vw, 300px" loading="lazy" />
          </a>
        ))}
      </div>
      <div class="center fade-in" style="margin-top:2.5rem">
        <a class="view-more-btn" href={withBase('/photography')}>View all {photoTotal} photos →</a>
      </div>
    </div>
  </section>

  <!-- ========================== ADVENTURES ========================== -->
  <section id="adventures" class="section">
    <div class="container">
      <h2 class="section-title fade-in">Beyond the Lab</h2>
      <p class="section-subtitle fade-in">“Why did you want to climb Mount Everest?” “Because it's there.” — George Mallory</p>
      <div class="adventures-grid fade-in">
        {adventures.map((a) => (
          <a class="adventure-card" href={withBase('/adventures')}>
            {a.cover && <Image src={a.cover} alt={a.title} widths={[400, 800]} sizes="(max-width:700px) 100vw, 360px" />}
            <div class="adventure-cap">
              <h3>{a.title}</h3>
              <span>{a.note}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================= MUSIC ============================= -->
  <section id="music" class="section bg-light">
    <div class="container music-inner">
      <h2 class="section-title fade-in">Drums</h2>
      <p class="section-subtitle fade-in">Drummer in a thrash-metal band — the loud counterweight to lab work.</p>
      <div class="fade-in"><VideoEmbed src="band.mp4" caption="Live cut — thrash-metal set." /></div>
    </div>
  </section>

  <!-- ============================= ABOUT ============================= -->
  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title fade-in">About Me</h2>
      <div class="about-content fade-in">
        <p>
          I'm a materials scientist finishing an <strong>MSc in Advanced Materials Science at
          UCL</strong> — in the <a href={GROUP.href} target="_blank" rel="noopener">{GROUP.name}</a>
          group led by {GROUP.lead} — after a BSc in Physics at the University of Edinburgh.
        </p>
        <p>
          My work keeps circling one question — <em>how does a material actually behave, and
          why?</em> — whether the material is a perovskite solar absorber, a bacterial biofilm,
          or blood in a spinning cylinder. I like problems that need both a rheometer and a
          Python script, and I care about materials that make cleaner technology possible.
        </p>
        <p>
          Away from the lab I climb mountains — <strong>Kilimanjaro</strong> and the
          <strong> Tour du Mont Blanc</strong> among them — and play drums in a thrash-metal band.
          Same discipline, louder.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section id="contact" class="section bg-light">
    <div class="container">
      <h2 class="section-title fade-in">Get in Touch</h2>
      <div class="contact-info fade-in">
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">✉️</div>
          <h3>Email</h3>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={`mailto:${SITE.altEmail}`}>{SITE.altEmail}</a>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">📄</div>
          <h3>CV</h3>
          <a href={withBase('/docs/CV.pdf')} target="_blank" rel="noopener">Download PDF ↗</a>
        </div>
        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">📍</div>
          <h3>Based in</h3>
          <p>{SITE.location}</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ---------------- Hero ---------------- */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding-block: var(--spacing-lg);
      margin-top: -65px;      /* 让背景延伸到 sticky 导航后方 */
      padding-top: 65px;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background-image: var(--hero-bg);
      background-size: cover; background-position: center;
      filter: blur(3px); transform: scale(1.06);
      z-index: 0;
    }
    .hero::after {
      content: '';
      position: absolute; inset: 0;
      background: rgba(255, 255, 255, 0.35);
      backdrop-filter: blur(1px);
      z-index: 1;
    }
    .hero-container {
      position: relative; z-index: 2;
      display: flex; align-items: center; gap: var(--spacing-lg);
    }
    .hero-image { flex: 0 0 260px; }
    .profile-photo {
      width: 260px; height: 260px; border-radius: 50%; object-fit: cover;
      border: 5px solid var(--color-white); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
    }
    .hero-content { flex: 1; }
    .hero-title { font-size: 2.9rem; margin-bottom: 0.3rem; }
    .hero-nick { color: var(--color-secondary); font-weight: 400; }
    .hero-subtitle { font-size: 1.35rem; color: var(--color-secondary); font-weight: 400; margin-bottom: 0.4rem; }
    .hero-affiliation { color: var(--color-text); margin-bottom: var(--spacing-sm); }
    .hero-bio { max-width: 56ch; color: var(--color-text); margin-bottom: var(--spacing-md); }
    .hero-tags { margin-bottom: var(--spacing-md); }
    .hero-social-icons { display: flex; gap: 1rem; }

    /* ---------------- Interests ---------------- */
    .interests-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--spacing-md); margin-top: var(--spacing-lg); }
    .interest-card { background: var(--color-white); padding: var(--spacing-md); border-radius: 12px; text-align: center; box-shadow: var(--shadow-card); transition: transform .3s ease, box-shadow .3s ease; }
    .interest-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-card-hover); }
    .interest-icon { font-size: 2.8rem; margin-bottom: var(--spacing-sm); }
    .interest-card h3 { font-size: 1.25rem; margin-bottom: 0.6rem; }
    .interest-card p { color: var(--color-text-light); font-size: 0.95rem; margin: 0; }

    /* ---------------- Skills ---------------- */
    .skills-grid { max-width: 820px; margin: 0 auto; display: grid; gap: 1.3rem; }
    .skill-card { background: var(--color-white); padding: 1.6rem 2rem; border-radius: 12px; box-shadow: var(--shadow-card); transition: transform .3s ease, box-shadow .3s ease; }
    .skill-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }
    .skill-card h4 { color: var(--color-accent); font-size: 1.15rem; margin-bottom: 0.5rem; }
    .skill-card p { color: var(--color-text-light); margin: 0; }

    /* ---------------- Experience ---------------- */
    .experience-list { max-width: var(--content); margin: var(--spacing-lg) auto 0; }
    .experience-item { display: flex; gap: var(--spacing-md); padding: var(--spacing-md); background: var(--color-white); border-radius: 8px; margin-bottom: var(--spacing-md); box-shadow: var(--shadow-card); transition: box-shadow .3s ease; }
    .experience-item:hover { box-shadow: var(--shadow-card-hover); }
    .exp-badge { flex: 0 0 56px; }
    .badge-logo { width: 56px; height: 56px; border-radius: 12px; object-fit: contain; background: #fff; border: 1px solid var(--color-border); padding: 5px; }
    .exp-content { flex: 1; }
    .exp-header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; }
    .exp-header h3 { font-size: 1.25rem; }
    .exp-period { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; }
    .exp-org { color: var(--color-secondary); font-weight: 600; margin: 0.3rem 0 0.6rem; }
    .exp-points { color: var(--color-text-light); padding-left: 1.1rem; line-height: 1.7; }
    .exp-points li + li { margin-top: 0.3rem; }

    /* ---------------- Certificates ---------------- */
    .awards-list { max-width: var(--content); margin: 0 auto; }
    .award-item { display: flex; gap: var(--spacing-md); align-items: flex-start; padding: var(--spacing-md); background: var(--color-white); border-radius: 8px; margin-bottom: var(--spacing-sm); box-shadow: var(--shadow-card); transition: transform .3s ease, box-shadow .3s ease; }
    .award-item:hover { transform: translateX(4px); box-shadow: var(--shadow-card-hover); }
    .award-badge { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 15px; font-size: 0.8rem; font-weight: 700; background: var(--color-accent-soft); color: var(--color-secondary); }
    .award-content h3 { font-size: 1.15rem; margin-bottom: 0.3rem; }
    .award-org { color: var(--color-text-light); font-size: 0.95rem; margin-bottom: 0.4rem; }
    .award-links { display: flex; gap: 1rem; font-weight: 600; font-size: 0.9rem; margin: 0; }

    /* ---------------- Photography ---------------- */
    .photo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--spacing-sm); }
    .photo-item { display: block; aspect-ratio: 4/3; overflow: hidden; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,.1); }
    .photo-item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .photo-item:hover :global(img) { transform: scale(1.08); }
    @media (max-width: 700px) { .photo-grid { grid-template-columns: repeat(2, 1fr); } }

    /* ---------------- Adventures ---------------- */
    .adventures-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); margin-top: var(--spacing-lg); }
    .adventure-card { position: relative; display: block; aspect-ratio: 3/4; overflow: hidden; border-radius: 12px; box-shadow: var(--shadow-card); }
    .adventure-card :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .adventure-card:hover :global(img) { transform: scale(1.06); }
    .adventure-cap { position: absolute; inset: auto 0 0 0; padding: 1.2rem; background: linear-gradient(to top, rgba(0,0,0,.8), transparent); color: #fff; }
    .adventure-cap h3 { color: #fff; font-size: 1.3rem; }
    .adventure-cap span { font-size: 0.9rem; opacity: 0.9; }
    @media (max-width: 700px) { .adventures-grid { grid-template-columns: 1fr; } .adventure-card { aspect-ratio: 16/10; } }

    /* ---------------- Music / About / Contact ---------------- */
    .music-inner { max-width: 820px; }
    .about-content { max-width: var(--content); margin: 0 auto; font-size: 1.08rem; line-height: 1.9; text-align: justify; }
    .about-content p { margin-bottom: 1.3rem; }
    .about-content p:first-child { font-size: 1.18rem; color: var(--color-secondary); }

    .contact-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); max-width: 900px; margin: var(--spacing-lg) auto 0; }
    .contact-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: var(--spacing-lg) var(--spacing-md); background: var(--color-white); border-radius: 8px; box-shadow: var(--shadow-card); transition: transform .3s ease, box-shadow .3s ease; }
    .contact-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
    .contact-icon { font-size: 1.8rem; width: 64px; height: 64px; display: grid; place-items: center; background: var(--color-background); border-radius: 50%; }
    .contact-item h3 { font-size: 1.05rem; margin: 0.3rem 0; }
    .contact-item a { color: var(--color-accent); font-weight: 500; word-break: break-word; }
    .contact-item p { margin: 0; color: var(--color-text-light); }
    @media (max-width: 768px) { .contact-info { grid-template-columns: 1fr; } }

    /* ---------------- Hero responsive ---------------- */
    @media (max-width: 820px) {
      .hero-container { flex-direction: column; text-align: center; gap: var(--spacing-md); }
      .hero-image { margin-top: 1rem; }
      .profile-photo { width: 200px; height: 200px; }
      .hero-tags, .hero-social-icons { justify-content: center; }
      .hero-bio { margin-inline: auto; }
    }
  </style>
</BaseLayout>
