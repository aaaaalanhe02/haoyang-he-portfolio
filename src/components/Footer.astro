---
import { MAIN_PROFILE, withBase, type Profile } from '../lib/site';

interface Props {
  profile?: Profile;
}
const { profile = MAIN_PROFILE } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p class="footer-name">{profile.name} <span class="footer-nick">({profile.nickname})</span></p>
    <p class="footer-role">{profile.role} · {profile.location}</p>

    <nav class="footer-links" aria-label="Footer">
      {profile.nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={withBase(profile.cv)}>CV</a>{profile.footerLinks?.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    </nav>

    <p class="footer-note">© {year} {profile.name}. Built with Astro.</p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: var(--spacing-lg) 0 var(--spacing-md);
    text-align: center;
  }
  .footer-name { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 600; color: #fff; }
  .footer-nick { color: rgba(255, 255, 255, 0.7); font-weight: 400; }
  .footer-role { color: rgba(255, 255, 255, 0.75); margin-bottom: 1.2rem; }
  .footer-links {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.4rem; margin-bottom: 1.2rem;
  }
  .footer-links a { color: var(--color-accent); font-size: 0.95rem; }
  .footer-links a:hover { color: #fff; }
  .footer-note { font-size: 0.9rem; opacity: 0.75; }
</style>
