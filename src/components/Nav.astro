---
import { MAIN_PROFILE, withBase, type Profile } from '../lib/site';

interface Props {
  currentPath: string;
  profile?: Profile;
}
const { currentPath, profile = MAIN_PROFILE } = Astro.props;
const NAV = profile.nav;
// side-nav 只在该站首页出现（主站 '/'，risk 子站 '/risk/'）；比较前去掉末尾斜杠
const trimSlash = (p: string) => p.replace(/\/+$/, '');
const isHome = trimSlash(currentPath) === trimSlash(withBase(profile.home));
---

<header class="site-header">
  <nav class="nav-container" aria-label="Primary">
    <a class="nav-brand" href={withBase(`${profile.home}#home`)}>{profile.name}</a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-menu">
      {
        NAV.map((item) => (
          <li>
            <a class="nav-link" href={withBase(item.href)} data-nav-id={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

{
  isHome && (
    <nav class="side-nav" aria-label="Section navigation">
      {NAV.filter((n) => n.id !== 'home').map((item) => (
        <a href={withBase(item.href)} data-nav-id={item.id}>
          {item.label}
        </a>
      ))}
    </nav>
  )
}

<script>
  // 汉堡菜单
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('.nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('active');
      toggle.classList.toggle('active', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.remove('active');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );
  }

  // scrollspy：高亮当前 section 对应的顶部导航与 side-nav
  const links = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-id]'));
  const byId = new Map<string, HTMLElement[]>();
  links.forEach((l) => {
    const id = l.dataset.navId!;
    byId.set(id, [...(byId.get(id) ?? []), l]);
  });
  const sections = document.querySelectorAll<HTMLElement>('main section[id]');
  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const targets = byId.get(e.target.id);
          if (!targets || targets.length === 0) return; // 无对应导航项的 section 保持上一个高亮
          links.forEach((l) => l.classList.remove('active'));
          targets.forEach((l) => l.classList.add('active'));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--color-white) 82%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }
  .nav-container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 1rem var(--spacing-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .nav-brand {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .nav-brand:hover { color: var(--color-primary); }
  .nav-menu {
    display: flex;
    list-style: none;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    position: relative;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--color-text);
    padding: 0.4rem 0;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width 0.3s ease;
  }
  .nav-link:hover { color: var(--color-primary); }
  .nav-link:hover::after,
  .nav-link.active::after { width: 100%; }
  .nav-link.active { color: var(--color-primary); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle span {
    width: 25px;
    height: 2px;
    background-color: var(--color-primary);
    transition: var(--transition-smooth);
  }
  .nav-toggle.active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.active span:nth-child(2) { opacity: 0; }
  .nav-toggle.active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .nav-toggle { display: flex; }
    .nav-menu {
      position: fixed;
      top: 64px;
      left: -100%;
      width: min(78%, 320px);
      height: calc(100vh - 64px);
      flex-direction: column;
      gap: 0.5rem;
      background: color-mix(in srgb, var(--color-white) 96%, transparent);
      backdrop-filter: blur(12px);
      padding: var(--spacing-md);
      box-shadow: 6px 0 24px rgba(0, 0, 0, 0.12);
      transition: left 0.3s ease;
    }
    .nav-menu.active { left: 0; }
    .nav-link { font-size: 1.15rem; display: block; padding: 0.5rem 0; }
  }
</style>
