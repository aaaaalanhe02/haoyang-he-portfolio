---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, subtitle, org, period, summary, cover, coverAlt, tags, category } =
  project.data;
const href = withBase(`/research/${project.id}`);

const catLabel: Record<string, string> = {
  research: 'Research',
  engineering: 'Engineering',
  data: 'Data',
};
---

<article class={`card card--${category}`}>
  <a class="card-media" href={href} aria-hidden="true" tabindex="-1">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800]}
          sizes="(max-width: 700px) 100vw, 400px"
          class="card-img"
        />
      ) : (
        <span class="card-placeholder">{title.charAt(0)}</span>
      )
    }
    <span class="card-cat">{catLabel[category]}</span>
  </a>
  <div class="card-body">
    <h3 class="card-title"><a href={href}>{title}</a></h3>
    {subtitle && <p class="card-subtitle muted">{subtitle}</p>}
    {
      (org || period) && (
        <p class="card-meta">
          {org}
          {org && period && ' · '}
          {period}
        </p>
      )
    }
    <p class="card-summary">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="tags card-tags">
          {tags.slice(0, 4).map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); transform: translateY(-2px); box-shadow: var(--shadow); }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-alt);
    overflow: hidden;
  }
  .card-img { width: 100%; height: 100%; object-fit: cover; }
  .card-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  }
  .card-cat {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-strong);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(4px);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
  .card-body { padding: 1rem 1.1rem 1.15rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .card-title { font-size: 1.15rem; }
  .card-title a { color: var(--text-strong); }
  .card-title a:hover { color: var(--accent-strong); text-decoration: none; }
  .card-subtitle { font-size: 0.9rem; margin-top: -0.15rem; }
  .card-meta { font-size: 0.85rem; color: var(--muted); }
  .card-summary { font-size: 0.95rem; }
  .card-tags { margin-top: 0.35rem; }
</style>
